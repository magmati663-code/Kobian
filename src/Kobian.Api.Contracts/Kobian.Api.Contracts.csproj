<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kontrakt gRPC kobian.v1 (D2.10). Generowanie kodu przez Grpc.Tools (tylko czas budowania). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kobian.Api.Contracts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <Protobuf Include="Protos\kobian\v1\agent.proto" GrpcServices="Both" ProtoRoot="Protos" />
  </ItemGroup>
</Project>
