<!-- Tokeny projektu (6.9, R2.6.3): kolory stanów zdefiniowane RAZ, w obu motywach; kontrast tekstu ≥ 4.5:1, ikon ≥ 3:1 (test ThemeContrastTests). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Kb.Color.Bg">#F6F5F2</Color>
      <Color x:Key="Kb.Color.Surface">#FFFFFF</Color>
      <Color x:Key="Kb.Color.Sunken">#EFEDE8</Color>
      <Color x:Key="Kb.Color.Border">#E2DFD8</Color>
      <Color x:Key="Kb.Color.Text">#1C1B19</Color>
      <Color x:Key="Kb.Color.TextMuted">#5C5A55</Color>
      <Color x:Key="Kb.Color.Accent">#0F5F5C</Color>
      <Color x:Key="Kb.Color.AccentText">#FFFFFF</Color>
      <Color x:Key="Kb.Color.NavBg">#10302E</Color>
      <Color x:Key="Kb.Color.NavText">#E6EFEE</Color>
      <Color x:Key="Kb.Color.NavMuted">#A9C2BF</Color>
      <Color x:Key="Kb.Color.NavSelected">#1F4D4A</Color>
      <Color x:Key="Kb.Color.Protected.Text">#13653A</Color>
      <Color x:Key="Kb.Color.Protected.Bg">#E3F3E8</Color>
      <Color x:Key="Kb.Color.Protected.Solid">#1B7F4A</Color>
      <Color x:Key="Kb.Color.Warning.Text">#7A4B00</Color>
      <Color x:Key="Kb.Color.Warning.Bg">#FDF0D5</Color>
      <Color x:Key="Kb.Color.Warning.Solid">#B26B00</Color>
      <Color x:Key="Kb.Color.AtRisk.Text">#A4231B</Color>
      <Color x:Key="Kb.Color.AtRisk.Bg">#FCE7E5</Color>
      <Color x:Key="Kb.Color.AtRisk.Solid">#C4321F</Color>
      <Color x:Key="Kb.Color.Paused.Text">#4A4F57</Color>
      <Color x:Key="Kb.Color.Paused.Bg">#ECEEF1</Color>
      <Color x:Key="Kb.Color.Paused.Solid">#6B7280</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Kb.Color.Bg">#121413</Color>
      <Color x:Key="Kb.Color.Surface">#1B1E1D</Color>
      <Color x:Key="Kb.Color.Sunken">#232726</Color>
      <Color x:Key="Kb.Color.Border">#333837</Color>
      <Color x:Key="Kb.Color.Text">#ECEDEA</Color>
      <Color x:Key="Kb.Color.TextMuted">#A6ABA8</Color>
      <Color x:Key="Kb.Color.Accent">#5CC8C0</Color>
      <Color x:Key="Kb.Color.AccentText">#0B1F1E</Color>
      <Color x:Key="Kb.Color.NavBg">#0B1716</Color>
      <Color x:Key="Kb.Color.NavText">#E6EFEE</Color>
      <Color x:Key="Kb.Color.NavMuted">#93ABA8</Color>
      <Color x:Key="Kb.Color.NavSelected">#1A3533</Color>
      <Color x:Key="Kb.Color.Protected.Text">#7FD9A2</Color>
      <Color x:Key="Kb.Color.Protected.Bg">#16291E</Color>
      <Color x:Key="Kb.Color.Protected.Solid">#2A8A55</Color>
      <Color x:Key="Kb.Color.Warning.Text">#F2C46D</Color>
      <Color x:Key="Kb.Color.Warning.Bg">#2E2412</Color>
      <Color x:Key="Kb.Color.Warning.Solid">#B06A00</Color>
      <Color x:Key="Kb.Color.AtRisk.Text">#FF9C92</Color>
      <Color x:Key="Kb.Color.AtRisk.Bg">#351816</Color>
      <Color x:Key="Kb.Color.AtRisk.Solid">#D2432C</Color>
      <Color x:Key="Kb.Color.Paused.Text">#B7BEC8</Color>
      <Color x:Key="Kb.Color.Paused.Bg">#24272C</Color>
      <Color x:Key="Kb.Color.Paused.Solid">#6E7684</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="Kb.Brush.Bg" Color="{DynamicResource Kb.Color.Bg}" />
  <SolidColorBrush x:Key="Kb.Brush.Surface" Color="{DynamicResource Kb.Color.Surface}" />
  <SolidColorBrush x:Key="Kb.Brush.Sunken" Color="{DynamicResource Kb.Color.Sunken}" />
  <SolidColorBrush x:Key="Kb.Brush.Border" Color="{DynamicResource Kb.Color.Border}" />
  <SolidColorBrush x:Key="Kb.Brush.Text" Color="{DynamicResource Kb.Color.Text}" />
  <SolidColorBrush x:Key="Kb.Brush.TextMuted" Color="{DynamicResource Kb.Color.TextMuted}" />
  <SolidColorBrush x:Key="Kb.Brush.Accent" Color="{DynamicResource Kb.Color.Accent}" />
  <SolidColorBrush x:Key="Kb.Brush.AccentText" Color="{DynamicResource Kb.Color.AccentText}" />
  <SolidColorBrush x:Key="Kb.Brush.NavBg" Color="{DynamicResource Kb.Color.NavBg}" />
  <SolidColorBrush x:Key="Kb.Brush.NavText" Color="{DynamicResource Kb.Color.NavText}" />
  <SolidColorBrush x:Key="Kb.Brush.NavMuted" Color="{DynamicResource Kb.Color.NavMuted}" />
  <SolidColorBrush x:Key="Kb.Brush.NavSelected" Color="{DynamicResource Kb.Color.NavSelected}" />
  <SolidColorBrush x:Key="Kb.Brush.Protected.Text" Color="{DynamicResource Kb.Color.Protected.Text}" />
  <SolidColorBrush x:Key="Kb.Brush.Protected.Bg" Color="{DynamicResource Kb.Color.Protected.Bg}" />
  <SolidColorBrush x:Key="Kb.Brush.Protected.Solid" Color="{DynamicResource Kb.Color.Protected.Solid}" />
  <SolidColorBrush x:Key="Kb.Brush.Warning.Text" Color="{DynamicResource Kb.Color.Warning.Text}" />
  <SolidColorBrush x:Key="Kb.Brush.Warning.Bg" Color="{DynamicResource Kb.Color.Warning.Bg}" />
  <SolidColorBrush x:Key="Kb.Brush.Warning.Solid" Color="{DynamicResource Kb.Color.Warning.Solid}" />
  <SolidColorBrush x:Key="Kb.Brush.AtRisk.Text" Color="{DynamicResource Kb.Color.AtRisk.Text}" />
  <SolidColorBrush x:Key="Kb.Brush.AtRisk.Bg" Color="{DynamicResource Kb.Color.AtRisk.Bg}" />
  <SolidColorBrush x:Key="Kb.Brush.AtRisk.Solid" Color="{DynamicResource Kb.Color.AtRisk.Solid}" />
  <SolidColorBrush x:Key="Kb.Brush.Paused.Text" Color="{DynamicResource Kb.Color.Paused.Text}" />
  <SolidColorBrush x:Key="Kb.Brush.Paused.Bg" Color="{DynamicResource Kb.Color.Paused.Bg}" />
  <SolidColorBrush x:Key="Kb.Brush.Paused.Solid" Color="{DynamicResource Kb.Color.Paused.Solid}" />

  <!-- Skala odstępów 4 px i typografia -->
  <x:Double x:Key="Kb.Space.1">4</x:Double>
  <x:Double x:Key="Kb.Space.2">8</x:Double>
  <x:Double x:Key="Kb.Space.3">12</x:Double>
  <x:Double x:Key="Kb.Space.4">16</x:Double>
  <x:Double x:Key="Kb.Space.6">24</x:Double>
  <x:Double x:Key="Kb.Space.8">32</x:Double>
  <x:Double x:Key="Kb.Font.Display">26</x:Double>
  <x:Double x:Key="Kb.Font.Title">18</x:Double>
  <x:Double x:Key="Kb.Font.Body">14</x:Double>
  <x:Double x:Key="Kb.Font.Caption">12</x:Double>
  <CornerRadius x:Key="Kb.Radius.Card">12</CornerRadius>
  <CornerRadius x:Key="Kb.Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Kb.Radius.Pill">999</CornerRadius>

  <!-- Ikony 24×24 (własne, proste kształty; F0 = EvenOdd) -->
  <StreamGeometry x:Key="Kb.Icon.Protected">M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Warning">M10.75 5h2.5v9h-2.5zm0 11h2.5v2.75h-2.5z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.AtRisk">M18.3 5.7 12 12l6.3 6.3-1.4 1.4L12 13.4l-6.3 6.3-1.4-1.4L10.6 12 4.3 5.7l1.4-1.4L12 10.6l6.3-6.3z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Paused">M7 5h3.5v14H7zm6.5 0H17v14h-3.5z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Brand">F0 M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z M10.6 15.6 7.4 12.4l1.4-1.4 1.8 1.8 4.6-4.6 1.4 1.4z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Nav.Dashboard">M12 3 2 12h3v8h5v-6h4v6h5v-8h3z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Nav.Jobs">M4 5h16v2H4zm0 6h16v2H4zm0 6h10v2H4z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Nav.Restore">M13 3a9 9 0 0 0-9 9H1l4 4 4-4H6a7 7 0 1 1 2.05 4.95l-1.42 1.42A9 9 0 1 0 13 3z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Nav.History">F0 M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16z M11 7h2v5.4l3.7 2.2-1 1.7L11 13.5z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Nav.Destinations">F0 M3 4h18v7H3z M3 13h18v7H3z M6 7v1.5h2V7z M6 16v1.5h2V16z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Nav.Settings">M3 6h11v2H3zm15 0h3v2h-3zm-4-2h2v6h-2zM3 16h4v2H3zm8 0h10v2H11zm-4-2h2v6H7z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Refresh">M17.65 6.35A8 8 0 1 0 19.73 14h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Folder">M3 5h7l2 2h9v12H3z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.File">M6 2h8l5 5v15H6zm7 1.5V8h4.5z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Lock">F0 M12 2a5 5 0 0 0-5 5v3H5v12h14V10h-2V7a5 5 0 0 0-5-5z M9 7a3 3 0 0 1 6 0v3H9z M11 14h2v4h-2z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Link">M8 11h8v2H8zm-1 5a4 4 0 0 1 0-8h3V6H7a6 6 0 0 0 0 12h3v-2zm10-10h-3v2h3a4 4 0 0 1 0 8h-3v2h3a6 6 0 0 0 0-12z</StreamGeometry>
  <StreamGeometry x:Key="Kb.Icon.Up">M12 4 5 11l1.4 1.4L11 7.8V20h2V7.8l4.6 4.6L19 11z</StreamGeometry>
</ResourceDictionary>
