<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia 12.1 — klient API (D6.1); tylko pakiety rdzenia MIT (D2.2). Telemetria budowania Avalonia wyłączona (AVALONIA_TELEMETRY_OPTOUT w tools/ci.sh). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Kobian.UI</RootNamespace>
    <NeutralLanguage>pl</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kobian.Tests.UI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kobian.Api.Contracts\Kobian.Api.Contracts.csproj" />
    <ProjectReference Include="..\Kobian.Domain\Kobian.Domain.csproj" />
  </ItemGroup>
</Project>
