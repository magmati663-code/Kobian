# Kobian Backup — Agent (usługa systemd). Instaluje install.sh do /etc/systemd/system/.
# Agent działa jako root (kopia całego systemu, odtwarzanie z właścicielem folderu docelowego). Dane: /var/lib/kobian, gniazdo: /run/kobian/agent.sock.
[Unit]
Description=Kobian Backup Agent
Documentation=file:///opt/kobian/README.txt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=KOBIAN_SERVICE=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/opt/kobian/Kobian.Agent
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
StateDirectory=kobian
StateDirectoryMode=0700
RuntimeDirectory=kobian
RuntimeDirectoryMode=0755
UMask=0077
LimitNOFILE=65536
# Utwardzenie zgodne z kopią i odtwarzaniem całego systemu (bez ProtectSystem/PrivateTmp — odtwarzanie do /etc albo /tmp musi trafiać tam, gdzie wskazano).
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
